import com.paypal.base.rest.APIContext;
import com.paypal.base.rest.OAuthTokenCredential;
import com.paypal.base.rest.PayPalRESTException;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

import java.util.HashMap;
import java.util.Map;

@Configuration
public class PaypalConfig {

    @Value("${paypal.client.id}")
    private String clientId;
    @Value("${paypal.client.secret}")
    private String clientSecret;
    @Value("${paypal.mode}")
    private String mode;


     // this method to do add configuration for paypalSDK by adding the mode (SandBox or live).
    @Bean
    public Map<String,String> payPalSDKConfig(){
        Map<String,String> config = new HashMap<String,String>();
        config.put("mode", mode);
        return config;
    }
    // this method to create OAuth with PayPal with client id and client secret
    @Bean
    public OAuthTokenCredential oAuthTokenCredential(){
        return new OAuthTokenCredential(clientId,clientSecret,payPalSDKConfig());

    }
    // this method to manage the api that interact with PayPal it contains the oAuth token and the configuration
    // to know that we use a sandbox for testing or a live production transactions
    @Bean
    public APIContext apiContext() throws PayPalRESTException {
        APIContext context = new APIContext(oAuthTokenCredential().getAccessToken());
        context.setConfigurationMap(payPalSDKConfig());
        return context;
    }

}
